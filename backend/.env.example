# Application Environment Configuration
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
LOG_LEVEL=info

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/pii_platform

# Redis & Queue Configuration
REDIS_URL=redis://localhost:6379

# Authentication & Security Configuration
JWT_ACCESS_SECRET=development-access-secret-key-32-chars-long-placeholder
JWT_REFRESH_SECRET=development-refresh-secret-key-32-chars-long-placeholder
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
MAX_FAILED_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15

# Storage & File Ingestion Configuration
MAX_UPLOAD_SIZE_BYTES=10485760
STORAGE_PATH=./storage
UPLOAD_RATE_LIMIT_WINDOW_MS=900000
UPLOAD_RATE_LIMIT_MAX=20

# Optional Microservices & Modalities
HTR_SERVICE_URL=http://localhost:8000
NER_SERVICE_URL=http://localhost:8001
METRICS_AUTH_TOKEN=

# Process Governance & Resource Limits
SHUTDOWN_TIMEOUT_MS=10000
MAX_MEDIA_DURATION_SECONDS=3600
MAX_MEDIA_FRAME_COUNT=300
MAX_UNCOMPRESSED_ARCHIVE_BYTES=52428800
MAX_IMAGE_DIMENSION_PX=10000
MAX_IMAGE_TOTAL_PIXELS=50000000
